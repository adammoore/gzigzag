{
  "name": "zigzag-web",
  "version": "4.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd packages/server && npm run dev",
    "dev:client": "cd packages/client && npm run dev",
    "build:all": "npm run build:core && npm run build:server && npm run build:client",
    "build:core": "cd packages/core && npm run build",
    "build:server": "cd packages/server && npm run build",
    "build:client": "cd packages/client && npm run build",
    "start:server": "cd packages/server && npm start",
    "migrate": "cd packages/server && npx ts-node src/migrate.ts",
    "test": "npm run test:core && npm run test:server && npm run test:client",
    "test:core": "cd packages/core && npm test",
    "test:server": "cd packages/server && npm test",
    "test:client": "cd packages/client && npm test",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "setup": "npm install && npm run docker:up && sleep 5 && npm run migrate"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
