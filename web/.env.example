# ZigZag Web Environment Variables
# Copy this file to .env and update with your values

# ============================================
# Server Configuration
# ============================================
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# ============================================
# Database Configuration - PostgreSQL
# ============================================
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://zigzag_user:zigzag_password@localhost:5432/zigzag

# ============================================
# Graph Database - Neo4j
# ============================================
# Local Neo4j:
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=your-neo4j-password

# Neo4j AuraDB (cloud):
NEO4J_URI=neo4j+s://xxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-auradb-password
NEO4J_DATABASE=neo4j

# ============================================
# Cache - Redis
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# Authentication
# ============================================
# Generate with: openssl rand -hex 32
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Optional: Strict session validation
STRICT_SESSION_VALIDATION=false

# ============================================
# Frontend Configuration
# ============================================
FRONTEND_URL=http://localhost:3000

# For production:
# FRONTEND_URL=https://zigzag-web.onrender.com

# ============================================
# CORS Configuration
# ============================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

# ============================================
# File Upload Configuration
# ============================================
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# ============================================
# Optional: AWS S3 for File Storage
# ============================================
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2

# ============================================
# Optional: Email Service (SendGrid)
# ============================================
SENDGRID_API_KEY=
FROM_EMAIL=noreply@zigzag.example.com

# ============================================
# Optional: Error Tracking (Sentry)
# ============================================
SENTRY_DSN=

# ============================================
# Optional: Analytics
# ============================================
GOOGLE_ANALYTICS_ID=
MIXPANEL_TOKEN=

# ============================================
# WebSocket Configuration
# ============================================
WS_HEARTBEAT_INTERVAL=30000
WS_AUTH_TIMEOUT=5000

# ============================================
# Database Pool Configuration
# ============================================
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=2000

# ============================================
# Neo4j Pool Configuration
# ============================================
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_ACQUISITION_TIMEOUT=60000

# ============================================
# Session Configuration
# ============================================
SESSION_TIMEOUT=86400000
SESSION_EXTEND_ON_ACTIVITY=true

# ============================================
# Monitoring & Health Checks
# ============================================
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=10000
HEALTH_CHECK_RETRIES=3

# ============================================
# Development Tools (disable in production)
# ============================================
ENABLE_SWAGGER=true
ENABLE_GRAPHQL_PLAYGROUND=false
ENABLE_DEBUG_LOGGING=false