*.msi
*.msm
*.msp
*.lnk

# Linux
*~
.directory
.gvfs

# ==================================================
# Original Java GzigZag files (preserve structure)
# ==================================================
# Java build outputs
*.class
*.jar
*.war
*.ear
target/
.mvn/
mvnw
mvnw.cmd

# Java IDE files
*.iml
.idea/
.project
.classpath
.settings/

# ==================================================
# ZigZag-specific files
# ==================================================
# Large demo data (keep structure, ignore large files)
Z/**/large_dataset*
Z/**/backup_*
Z/**/temp_*

# Generated ZigZag exports
*.zzexport
*.zzbackup

# ==================================================
# Logs and temporary files
# ==================================================
logs/
*.log
*.log.*
.tmp/
tmp/
temp/

# ==================================================
# Testing and coverage
# ==================================================
coverage/
.nyc_output/
junit.xml
test-results/
playwright-report/
test-results.xml

# ==================================================
# Database files (for future backend)
# ==================================================
*.db
*.sqlite
*.sqlite3

# ==================================================
# Docker (for future deployment)
# ==================================================
.dockerignore

# ==================================================
# Deployment and CI/CD
# ==================================================
.vercel/
.netlify/
.render/

# ==================================================
# Package manager lock files (keep one, ignore others)
# ==================================================
# Keep package-lock.json, ignore others
yarn.lock
pnpm-lock.yaml

# ==================================================
# Large binary files
# ==================================================
*.zip
*.tar.gz
*.rar
*.7z