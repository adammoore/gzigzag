npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# ==================================================
# Build outputs and distributions
# ==================================================
dist/
build/
*.tsbuildinfo
.vite/
.cache/

# ==================================================
